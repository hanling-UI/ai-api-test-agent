# 数据库：本地用 compose 里的 db；线上用 Neon/Supabase 的连接串（记得加 ?sslmode=require）
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/postgres

# JWT
JWT_SECRET=change-me-in-production

# 大模型（OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FAST=qwen-flash
LLM_SMART=qwen-plus

# 被测服务（容器内由 start.py 启动）
TARGET_BASE_URL=http://127.0.0.1:9000

# 演示账号密码
DEMO_PASSWORD=demo1234
